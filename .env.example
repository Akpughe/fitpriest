# ============================================
# THE FITNESS PRIEST - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ============================================
# AIRTABLE CONFIGURATION
# ============================================
# Your Airtable Personal Access Token (PAT)
# Get it from: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_API_KEY=your_airtable_api_key_here

# Your Airtable Base ID
# Find it in the URL: https://airtable.com/[BASE_ID]/...
# Or get it from the API documentation for your base
AIRTABLE_BASE_ID=your_airtable_base_id_here

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
# NextAuth Secret - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# NextAuth URL - Your app's URL
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================
# STRIPE PAYMENTS
# ============================================
# Stripe Secret Key (starts with sk_)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Publishable Key (starts with pk_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Webhook Secret (starts with whsec_)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================
# EMAIL (Resend)
# ============================================
# Resend API Key
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email "From" address (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# GOOGLE CALENDAR API
# ============================================
# Google Calendar API Key
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here

# Google Service Account JSON (for server-side calendar access)
# Create a service account and download the JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY=your_google_private_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================
# Node environment
NODE_ENV=development

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
